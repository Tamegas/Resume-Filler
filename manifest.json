{
  "manifest_version": 3,
  "name": "Internship AutoFill",
  "version": "1.0.0",
  "description": "Fill internship application forms from your resume and attach your resume file automatically.",
  "permissions": ["storage", "activeTab", "unlimitedStorage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Internship AutoFill" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
